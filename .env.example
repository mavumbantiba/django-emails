# Copy this file to .env and replace the placeholders with your SMTP settings.
EMAIL_HOST=smtp.your-provider.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-email@example.com
EMAIL_HOST_PASSWORD=replace-with-your-smtp-password
DEFAULT_FROM_EMAIL=your-email@example.com

# Optional social sign-in. Set both values for each provider you want to enable.
# Register each absolute callback URL using your deployed domain, for example:
# https://your-domain.example/accounts/google/login/callback/
# https://your-domain.example/accounts/microsoft/login/callback/
# https://your-domain.example/accounts/github/login/callback/
# https://your-domain.example/accounts/amazon/login/callback/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
AMAZON_CLIENT_ID=
AMAZON_CLIENT_SECRET=
